[Unit]
Description=Sophia command telemetry server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=debian
Group=debian
WorkingDirectory=/home/debian/sophia
EnvironmentFile=/home/debian/sophia/sophia.env
ExecStart=/home/debian/sophia/.venv/bin/sophia-server
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
